<?xml version="1.0"?>
<package format="3">
  <name>harness_nodes</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for the always-on Harness.</description>
  <maintainer email="maintainers@example.invalid">Harness maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>harness_interfaces</depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-httpx</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
